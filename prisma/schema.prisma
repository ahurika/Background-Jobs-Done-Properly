datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id             String    @id @default(uuid())
  type           String
  payload        String    // Stored as stringified JSON for SQLite compatibility
  status         String    // "pending" | "processing" | "succeeded" | "failed" | "dead"
  attempts       Int       @default(0)
  maxAttempts    Int
  lastError      String?
  runAt          DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  idempotencyKey String    @unique
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
  @@index([userId])
}
